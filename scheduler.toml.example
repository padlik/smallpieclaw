# scheduler.toml
# Scheduled job configurations.
#
# Schedules use 5-field cron expressions (local server time):
#   cron = "minute hour day month weekday"
#
# Common examples:
#   "0 2 * * *"    → daily at 02:00
#   "0 */6 * * *"  → every 6 hours (00:00, 06:00, 12:00, 18:00)
#   "0 */4 * * *"  → every 4 hours
#   "*/30 * * * *" → every 30 minutes
#   "0 9 * * 1"    → every Monday at 09:00
#
# Fields per job:
#   enabled              = true/false
#   schedule             = "cron"        (or "once" for one-time jobs)
#   cron                 = "<expression>"
#   run_at               = "HH:MM"       (for schedule = "once")
#   task                 = "goal string sent to agent"
#   notify               = true/false    (send result to Telegram users)
#   model                = "<model>"     (optional: override background_model for this job)
#   preserve_context     = true/false    (keep ShortTermMemory between runs; default: false)
#   context_max_messages = N             (sliding window size when preserve_context=true; default: 50)
#   overlap_policy       = "skip"|"parallel"  (what to do if previous run is still active; default: skip)
#   fallback_models      = ["<model>"]   (DEPRECATED: parsed but ignored — the LLM client
#                                         is now single-model. Remove from existing jobs.)

[jobs.longterm_memory_update]
enabled = true
schedule = "cron"
cron = "0 3 * * *"
task = "Summarize the key events, system findings, and actions taken today into a concise paragraph for long-term memory."
notify = false

[jobs.agent_health]
enabled = true
schedule = "cron"
cron = "0 */4 * * *"
task = "Perform a self-health diagnosis: (1) Use the log_query built-in tool to retrieve recent WARNING+ and failed events (warnings, errors, and TOOL_FAILED/LLM_FAILED entries) from the structured log instead of reading raw prose lines. (2) Analyze them for repeated failures and anomalies. (3) Identify root causes and provide actionable suggestions. (4) Report findings as a structured summary."
notify = true
# Use a smarter model for deep log analysis; preserve context to track trends over time
# model = "claude-3-5-sonnet-20241022"
# preserve_context = true
# context_max_messages = 50
