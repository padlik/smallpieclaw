# scheduler.toml
# Scheduled job configurations.
#
# Schedules use 5-field cron expressions (local server time):
#   cron = "minute hour day month weekday"
#
# Common examples:
#   "0 2 * * *"    → daily at 02:00
#   "0 */6 * * *"  → every 6 hours (00:00, 06:00, 12:00, 18:00)
#   "0 */4 * * *"  → every 4 hours
#   "*/30 * * * *" → every 30 minutes
#   "0 9 * * 1"    → every Monday at 09:00
#
# Fields per job:
#   enabled              = true/false
#   schedule             = "cron"        (or "once" for one-time jobs)
#   cron                 = "<expression>"
#   run_at               = "HH:MM"       (for schedule = "once")
#   task                 = "goal string sent to agent"
#   notify               = true/false    (send result to Telegram users)
#   model                = "<connection-id>/<upstream-id>"  (optional: explicit route for this job)
#   preserve_context     = true/false    (keep ShortTermMemory between runs; default: false)
#   context_max_messages = N             (sliding window size when preserve_context=true; default: 50)
#   overlap_policy       = "skip"|"parallel"  (what to do if previous run is still active; default: skip)
#   max_iterations       = N             (DEPRECATED: parsed but ignored — agents now run
#                                         until they finish or hit a failure loop. Remove from existing jobs.)
#
# Job model selection: a job without `model` inherits the active Main selection when it
# launches (and fails with an actionable error if there is none). A `model` key is used
# exactly as saved (split at the first "/", the connection must be a configured
# [providers.<id>] and the rest is sent verbatim); it needs no cached catalog entry. A
# blank, malformed or unknown-connection selector fails only that job's run, with an
# alert, and never falls back to Main or another model.
#
# Legacy job file: a scheduler_jobs.json in the agent's state directory is inert. Only its
# existence is checked (one notice); it is never read, run, converted or deleted, so
# recreate any job you still need here by hand.
#
# Obsolete fields (never converted or ignored — remove them):
#   schedule = "daily"/"interval", time, hours, minutes   → the job is NOT scheduled and shows a
#                                         config_error; rewrite it with schedule = "cron" and cron,
#                                         or schedule = "once" with run_at = "HH:MM".
#   fallback_models                       → every launch of the job fails (recorded, with an alert)
#                                         until the key is removed; jobs never fall back to another model.
#   Other jobs keep running; the file is never rewritten for you.

[jobs.longterm_memory_update]
enabled = true
schedule = "cron"
cron = "0 3 * * *"
task = "Summarize the key events, system findings, and actions taken today into a concise paragraph for long-term memory."
notify = false

[jobs.agent_health]
enabled = true
schedule = "cron"
cron = "0 */4 * * *"
task = "Perform a self-health diagnosis: (1) Use the log_query built-in tool to retrieve recent WARNING+ and failed events (warnings, errors, and TOOL_FAILED/LLM_FAILED entries) from the structured log instead of reading raw prose lines. (2) Analyze them for repeated failures and anomalies. (3) Identify root causes and provide actionable suggestions. (4) Report findings as a structured summary."
notify = true
# Use a smarter model for deep log analysis; preserve context to track trends over time
# model = "anthropic-main/claude-example-model"   # fake id; use <connection-id>/<upstream-id>
# preserve_context = true
# context_max_messages = 50
