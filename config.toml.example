# Telegram Home Agent Configuration
#
# Environment variables and vault secrets can be referenced in string config values
# using two prefixes:
#
#   env:VAR_NAME   — looks up VAR_NAME in the process environment
#   sec:KEY_NAME   — looks up KEY_NAME in the agent's vault file
#
# The entire string value must be exactly "env:VAR_NAME" or "sec:KEY_NAME" —
# no inline interpolation or partial substitution. Missing references cause a
# startup error with a clear message.
#
# Examples:
#   bot_token = "env:TELEGRAM_BOT_TOKEN"
#   api_key   = "sec:OPENAI_API_KEY"
#
# Vault file location: ~/.local/state/<agent_name>/secrets.toml (XDG_STATE_HOME)
# Not independently configurable — derived from XDG env vars, same as all other
# agent storage paths.
#
# Vault format (TOML — plain key = "value" pairs):
#   OPENAI_API_KEY = "sk-..."
#   OLLAMA_HOST    = "http://localhost:11434"
#
# For values with a prefix (e.g. Bearer tokens in MCP headers), put the
# full header value in the vault and reference it directly:
#   Authorization = "sec:MY_AUTH_HEADER"   # where MY_AUTH_HEADER="Bearer sk-..."
#
# This keeps secrets out of config.toml. Values referenced with sec: are
# resolved at startup and never cached in os.environ, so they are not leaked
# to shell/tool/MCP subprocesses.

[telegram]
bot_token = "sec:TELEGRAM_BOT_TOKEN"
# Alternative using an environment variable:
# bot_token = "env:TELEGRAM_BOT_TOKEN"
# Security mode: "allowlist" or "pairing"
security_mode = "allowlist"
# Comma-separated list of allowed Telegram user IDs (for allowlist mode)
allowed_user_ids = []
# Pairing timeout in seconds (for pairing mode)
pairing_timeout = 300

# ---------------------------------------------------------------------------
# LLM Models
# Define one or more [[models]] entries. The active model is chosen by
# matching agent.default_model against the 'model' field of each entry.
# Users can switch manually with /models.
#
# Provider defaults can be defined once and inherited by matching [[models]]
# entries. Model-level fields override provider-level defaults.
#
# [providers.openai]
# api_key         = "sec:OPENAI_API_KEY"
# base_url        = "https://api.openai.com/v1"
# request_timeout = 120
# max_retries     = 5
# retry_delay     = 2
#
# Fields per model:
#   name             — display name shown in /models
#   provider         — openai | openrouter | google | anthropic | ollama
#   api_key          — provider API key (or inherit from [providers.<name>])
#   model            — exact model identifier (used to match default_model)
#   base_url         — API base URL (leave empty for Anthropic/Google defaults)
#   max_tokens       — max tokens in LLM response
#   temperature      — sampling temperature
#   top_p            — nucleus sampling (optional; omit to use provider default)
#   request_timeout  — per-request timeout in seconds (default: 120)
#   max_retries      — retry attempts on timeout/connection errors (default: 5)
#   retry_delay      — base retry delay in seconds, doubles each attempt (default: 2)
#   vision           — true if the model accepts image input (informational; shown in /models)
# ---------------------------------------------------------------------------
[[models]]
name            = "default"
provider        = "openai"
api_key         = "sec:OPENAI_API_KEY"
# Alternative using an environment variable:
# api_key       = "env:OPENAI_API_KEY"
model           = "gpt-4o-mini"
base_url        = "https://api.openai.com/v1"
max_tokens      = 1024
temperature     = 0.2
vision          = true   # gpt-4o-mini supports image input
# top_p         = 0.9  # optional: nucleus sampling (omit to use provider default)
# aliases       = ["gpt-4o-mini"]  # optional: names to match against models_capabilities.json
# context_window = 128000  # optional: per-model context window in tokens.
#   When set, the compaction threshold is derived from this value instead of
#   agent.ctx_max_tokens. Falls back to agent.ctx_max_tokens when unset.
#   Must be greater than max_tokens (validated at startup).
request_timeout = 120
max_retries     = 5
retry_delay     = 2

# Example second model
# [[models]]
# name            = "smart"
# provider        = "anthropic"
# api_key         = "env:ANTHROPIC_API_KEY"
# model           = "claude-3-5-sonnet-20241022"
# base_url        = ""
# max_tokens      = 8192
# temperature     = 0.2
# request_timeout = 180
# max_retries     = 5
# retry_delay     = 2

# Ollama Cloud API (https://ollama.com) — hosted cloud models.
# Requires the 'ollama' Python package (pip install ollama>=0.4.0).
# Create an API key at https://ollama.com/settings/keys.
# Available cloud models: https://ollama.com/search?c=cloud
# Examples: gpt-oss:120b-cloud, deepseek-v3.1:671b-cloud, kimi-k2:1t-cloud
# [[models]]
# name            = "ollama-cloud"
# provider        = "ollama"
# api_key         = "env:OLLAMA_API_KEY"
# model           = "kimi-k2:1t-cloud"
# base_url        = "https://ollama.com"
# max_tokens      = 4096
# temperature     = 0.2
# aliases         = ["kimi-k2.6", "kimi-k2"]  # map to models_capabilities.json entries
# request_timeout = 300
# max_retries     = 3
# retry_delay     = 2

# Ollama local instance (no API key required).
# Make sure Ollama is running: https://ollama.com/download
# Pull a model first: ollama pull gemma3:27b
# [[models]]
# name            = "ollama-local"
# provider        = "ollama"
# api_key         = ""
# model           = "gemma3:27b"
# base_url        = "http://localhost:11434"
# max_tokens      = 4096
# temperature     = 0.2
# request_timeout = 120
# max_retries     = 3
# retry_delay     = 2

[embeddings]
# Use same provider as LLM or configure separately.
# If api_key is empty and a matching [providers.<name>] entry exists,
# embeddings inherit provider credentials/base_url. Otherwise embeddings fall
# back to the active model's api_key/base_url at runtime.
provider = "openai"
api_key  = "sec:OPENAI_API_KEY"
# Alternative using an environment variable:
# api_key = "env:OPENAI_API_KEY"
model    = "text-embedding-3-small"
base_url = "https://api.openai.com/v1"

[agent]
# Logical agent name used to derive default shared state locations.
# Defaults to "piclaw" when omitted.
agent_name = "piclaw"
# Agent home directory. Defaults to ~/<agent_name> when omitted or empty.
# The vault path is independent and defaults to ~/.local/share/<agent_name>/secrets.toml.
# agent_home = "~/piclaw"
max_iterations = 8
tool_timeout   = 10
# Maximum chars returned by the shell tool and registered tools per stream
# (stdout and stderr each). When output exceeds this limit the tail is kept
# and a truncation marker is prepended, so the LLM always sees the end of
# the output (where errors and results typically appear). The full untruncated
# output is also saved to a run-specific artifact under
# ~/.local/state/<agent>/session_logs/<conversation_id>/
# and the returned tail includes the path so it can be recovered via file_read.
# Increase for sophisticated scripts that produce large logs.
max_output_size = 4000
top_tools      = 3
# Must match the 'model' field of one [[models]] entry.
default_model  = "gpt-4o-mini"
# Model used by sub-agents (scheduled jobs and spawn_agent tool).
# Must match the 'model' field of a [[models]] entry. Defaults to default_model if not set.
# background_model = "gpt-4o-mini"
# DEPRECATED: agent.fallback_models — parsed but ignored with a deprecation warning.
# The LLM client is now single-model. Vision auto-switch works with any configured
# vision model (set vision = true on a [[models]] entry) — no fallback list needed.
# fallback_models = ["claude-3-haiku-20240307", "gemini-1.5-flash"]
# Maximum estimated context tokens per LLM request (4 chars ≈ 1 token).
# When 85% is reached the agent auto-summarises older messages before the next call.
ctx_max_tokens = 90000
# Enable verbose diagnostics when the LLM returns empty content (default: false).
# Logs full HTTP response, checks stream/non-stream mismatch, finish_reason, and runs a curl probe.
diagnose_empty_responses = false
# Hard cap on concurrent managed (on-demand) sub-agents. Scheduler jobs do not count toward this cap.
# Attempting to spawn beyond this limit returns a hard error. Default: 6.
max_subagents = 6
# Timeout in seconds for get_agent_result tool when waiting for a sub-agent to finish. Default: 300.
subagent_result_timeout = 300
# Max steps for scheduled/background sub-agents (independent of max_iterations for chat sessions).
# Set to 0 for no limit (capped internally at 500). Default: 100.
scheduled_max_iterations = 100
# Warn in chat when a sub-agent has been running longer than this many minutes. 0 = disabled.
long_run_warn_minutes = 30
# Shell execution backend.
#   "subprocess" (default) — cross-platform, fully buffered. Safe and simple.
#   "pty"                  — POSIX only (Linux/macOS). Spawns the child inside a
#                            pseudo-terminal so it sees isatty()=True. This enables
#                            line-buffered output, ANSI colours, progress bars, and
#                            commands that require a controlling terminal (e.g. pytest
#                            live progress, git colours, npm spinners). Recommended
#                            for sophisticated multi-step scripts.
#                            Requires: ptyprocess>=0.7.0 (usually already installed).
#   "nsjail"               — Linux only. Runs shell commands inside a kernel-level
#                            sandbox (mount/PID/net/user/IPC/UTS/cgroup namespaces +
#                            cgroup v2 resource limits). Confines blast radius to the
#                            project directory and explicitly trusted RW directories.
#                            See docs/nsjail-setup.md for installation and prerequisites.
#                            Falls back to "subprocess" on macOS or if the nsjail
#                            binary is missing.
# shell_backend = "subprocess"
# Terminal dimensions reported to child processes in PTY mode.
# Wider columns prevent spurious line-wrapping in captured text.
# shell_pty_cols = 220
# shell_pty_rows = 50
# Stream live shell output to the progress panel chunk-by-chunk.
# Requires shell_backend = "pty".  Updates are debounced at the panel's
# 1.5 s edit interval so Telegram rate limits are not hit.
# shell_streaming = false
#
# nsjail shell backend — confirmation gate and resource limits.
# Only take effect when shell_backend = "nsjail". When nsjail is inactive
# (binary missing or non-Linux host), all modes fall back to "always".
#
# shell_nsjail_confirm_mode — confirmation gate for dangerous shell patterns:
#   "always"   (default) — confirm all dangerous patterns. Backward-compatible
#                          with the subprocess backend.
#   "adaptive"           — skip confirmation for "network"-category patterns
#                          (curl|sh, wget|sh, /dev/tcp, nc -e) when network
#                          isolation is active (allow_net = false).
#                          All other categories (host_escape, project, resource,
#                          policy) still require confirmation.
#   "never"              — skip confirmation for all dangerous patterns while
#                          nsjail is active. WARNING: RW-mounted host dirs
#                          (project dir, RW trusted dirs) are NOT protected by
#                          the jail — `rm -rf` on a project path deletes real
#                          host files. Use with caution.
# shell_nsjail_confirm_mode = "always"
# shell_nsjail_memory_mb    = 256   # memory cap in MB (cgroup, or RLIMIT_AS fallback)
# shell_nsjail_pids_max     = 64    # max PIDs inside the jail (cgroup only)
# shell_nsjail_cpu_percent  = 50    # CPU quota as % of one core (cgroup only)
# shell_nsjail_dump_config_on_error = false  # when true, on an nsjail setup failure
#                          the generated nsjail config file is copied into the
#                          per-conversation session_logs directory for debugging.
#                          Default: false.
# allow_net                 = false  # false = isolated (no network), true = share host network
# When allow_net = true, the system CA certificate store is mounted read-only
# inside the nsjail jail and SSL_CERT_FILE / SSL_CERT_DIR env vars are injected
# so TLS-dependent tools (curl, git, Python ssl) can verify certificates.
# dns_nameserver            = "8.8.8.8"  # nameserver written to /etc/resolv.conf
#                          inside the jail when allow_net = true (the jail has
#                          an isolated mount namespace, so the host's resolv.conf
#                          is not visible). Defaults to Google public DNS.
# session_logs_retention_days  = 7     # delete session_logs folders older than N days (default 7)

[scheduler]
enabled = true

# ─────────────────────────────────────────────────────────────────────────────
# Vault (file-backed key-value store for secrets)
# The vault is a TOML file where each top-level key maps to a string secret.
# The agent can reference vault keys with the sec: prefix in any string config
# value, and the secret_get built-in tool can retrieve values at runtime
# (requires user confirmation).
# ─────────────────────────────────────────────────────────────────────────────
[vault]
type = "file"
# The vault path is not configurable — always ~/.local/state/<agent_name>/secrets.toml
# (XDG_STATE_HOME), derived the same way as every other agent storage path.

# ─────────────────────────────────────────────────────────────────────────────
# Graph-Based Memory (opt-in — disabled by default)
# Requires: pip install ladybug  (LadybugDB — community fork of KuzuDB)
# Also requires [embeddings] to be configured (reuses the same embedding model).
# ─────────────────────────────────────────────────────────────────────────────
# [graph_memory]
# enabled               = false        # set to true to enable
# # db_path is not configurable — always <XDG_DATA_HOME>/<agent_name>/graph_memory
# buffer_pool_mb        = 256          # RAM for DB buffer pool (lower on Pi 3/4)
# # extraction_model: model to use for triplet extraction (LLM call per batch).
# # Must match the 'model' field of a [[models]] entry. Falls back to default_model.
# # extraction_model    = "gpt-4o-mini"
# extract_every_n_turns = 3            # batch: extract every N user turns (cost control)
# min_message_length    = 100          # skip short messages / chatter
# max_context_entries   = 10           # max entities/facts injected into prompt

[paths]
# All agent storage (config, data, state, cache, logs, pid file, skills, vault,
# scheduler files) is derived from XDG Base Directory env vars (XDG_CONFIG_HOME,
# XDG_DATA_HOME, XDG_STATE_HOME, XDG_CACHE_HOME, XDG_RUNTIME_DIR) scoped under
# the agent's --agent-name. None of those paths are configurable here.
workspace_dir       = "~/Documents/piclaw_workspace"  # primary user workspace; always a trusted file-access zone (file_* tools auto-allow here)
log_backup_count   = 30         # daily gzip-compressed, date-suffixed backups to keep
# Agent's temp/handoff directory is always /tmp/<agent_name> (agent.agent_name);
# there is no config override for it.
#
# Trusted directories store (user-added file-access zones + nsjail mount list):
#   ~/.local/state/<agent_name>/trusted_dirs.json
# Resolved from XDG_STATE_HOME (or ~/.local/state) + agent_name. This path is
# deliberately kept OUTSIDE the project dir so a sandboxed shell cannot rewrite
# its own mount list. Managed at runtime via the /dir command (list/del/reload).
# A one-time migration copies data/trusted_dirs.json to the XDG location on
# first start; new installs start empty.

# ─────────────────────────────────────────────────────────────────────────────
# MCP Servers (Model Context Protocol)
# Use [[mcp_servers]] to configure one or more MCP servers.
# Two transports are supported: "stdio" (subprocess) and "http" (HTTP/HTTPS).
# ─────────────────────────────────────────────────────────────────────────────

# Example: stdio MCP server (subprocess with JSON-RPC over stdin/stdout)
# [[mcp_servers]]
# name      = "filesystem"
# transport = "stdio"
# command   = ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
# enabled   = true
# timeout   = 30
# [mcp_servers.env]
# MY_ENV_VAR = "value"
# API_KEY    = "env:SOME_SERVICE_API_KEY"

# Example: HTTP MCP server (JSON-RPC POST to HTTP/HTTPS endpoint)
# [[mcp_servers]]
# name      = "my-api"
# transport = "http"
# url       = "https://api.example.com/mcp"
# enabled   = true
# timeout   = 30
# [mcp_servers.headers]
# Authorization = "env:MY_AUTH_HEADER"    # set MY_AUTH_HEADER="Bearer sk-..." in env

# Example: HTTP MCP server with OAuth 2.0 (authorization-code + PKCE flow)
# This example uses Google's Gmail MCP (https://gmailmcp.googleapis.com/mcp/v1).
#
# Prerequisites:
#   1. Create an OAuth app in Google Cloud Console (https://console.cloud.google.com)
#   2. Generate OAuth 2.0 credentials (type: Web Application)
#   3. Add your callback URI to the app's authorized redirect URIs:
#      https://<your-dynamic-dns-hostname>:<callback_port>/oauth/callback
#   4. Generate a self-signed HTTPS certificate or use Let's Encrypt for the hostname:
#      openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
#   5. Store the certificate and key files securely; reference them in config below
#   6. Ensure your router forwards the callback port to this machine
#
# To authorize:
#   - Run `/mcp auth gmail` in Telegram
#   - Tap the authorization URL button
#   - Complete the OAuth flow with Google
#   - The agent stores tokens at $XDG_STATE_HOME/<agent_name>/mcp_tokens/gmail.json
#   - The agent automatically refreshes expired tokens on next tool call (or use /mcp auth gmail to re-auth)
#
# [[mcp_servers]]
# name      = "gmail"
# transport = "http"
# url       = "https://gmailmcp.googleapis.com/mcp/v1"
# enabled   = true
# timeout   = 30
#
# [mcp_servers.oauth]
# # From Google Cloud Console OAuth 2.0 credentials
# client_id           = "sec:GMAIL_MCP_CLIENT_ID"
# client_secret       = "sec:GMAIL_MCP_CLIENT_SECRET"
# # Must match the redirect URI registered in Google Cloud Console
# redirect_uri        = "https://<your-dynamic-dns-hostname>:8000/oauth/callback"
# # Scopes for Gmail API — adjust based on OAuth app permissions
# scope               = "https://www.googleapis.com/auth/gmail.readonly"
# # Callback server settings (ephemeral HTTPS server that listens only during auth flow)
# callback_port       = 8000
# callback_bind       = "0.0.0.0"    # bind to all interfaces; set to "127.0.0.1" for local only
# # Path to TLS certificate and private key (see prerequisites above)
# cert_path           = "/path/to/cert.pem"
# key_path            = "/path/to/key.pem"
# # Diagnostic flag: when true, the full authorization URL (containing client_id,
# # scope, state, code_challenge) is logged at INFO during the auth flow.
# # Not for production use — enable only when diagnosing OAuth issues.
# trace               = false
# # Provider-specific authorization parameters (optional, default: empty).
# # Google requires access_type=offline and prompt=consent to return a
# # refresh_token — without it the access_token expires in ~1 hour and
# # re-auth via browser is needed every time.  prompt=consent forces the
# # consent screen on every auth (ensures refresh_token on re-auth).
# # Only set this for Google; prompt=consent is a standard OIDC param that
# # non-Google servers (Okta, Auth0, Microsoft) will honor.
# extra_auth_params   = { access_type = "offline", prompt = "consent" }
